{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chengkai-Zhu/research-lineage/schema/map-v1.json",
  "title": "Research Lineage map v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "scope": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "cutoff": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "coverage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "search_strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 0,
          "maxItems": 500
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "summary",
        "cutoff",
        "coverage",
        "search_strategy",
        "exclusions",
        "gaps"
      ],
      "additionalProperties": false
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "color": {
            "type": "string",
            "enum": [
              "teal",
              "blue",
              "amber",
              "rose",
              "violet"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "color"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "minItems": 1,
            "maxItems": 100
          },
          "first_published": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "published": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "format": "uri"
                }
              },
              "required": [
                "id",
                "label",
                "published",
                "url"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 30
          }
        },
        "required": [
          "id",
          "title",
          "authors",
          "first_published",
          "versions"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 250
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "work_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "lane": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "foundation",
              "framework",
              "extension",
              "challenge",
              "tutorial",
              "result"
            ]
          },
          "settings": {
            "type": "object",
            "properties": {
              "input": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 2000
              },
              "assumptions": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 2000
              },
              "cost": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 2000
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "input",
              "assumptions",
              "cost",
              "error"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "minItems": 1,
            "maxItems": 500
          },
          "review_status": {
            "type": "string",
            "enum": [
              "proposed",
              "reviewed"
            ]
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "format": "uri"
                }
              },
              "required": [
                "name",
                "url"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 20
          }
        },
        "required": [
          "id",
          "work_id",
          "version_id",
          "label",
          "summary",
          "lane",
          "kind",
          "settings",
          "evidence",
          "review_status",
          "reviews"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 250
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "work_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "format": "uri"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "type": "string",
            "enum": [
              "abstract",
              "full_text",
              "metadata"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "checked": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "work_id",
          "version_id",
          "url",
          "locator",
          "kind",
          "summary",
          "checked"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "generalizes",
              "uses_result",
              "improves_bound",
              "simplifies",
              "surveys",
              "critiques",
              "refutes_claim",
              "addresses",
              "independent_parallel",
              "empirically_checks",
              "cites"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "minItems": 1,
            "maxItems": 500
          },
          "basis": {
            "type": "string",
            "enum": [
              "author_explicit",
              "editorial_inference",
              "citation_only"
            ]
          },
          "comparability": {
            "type": "string",
            "enum": [
              "not_assessed",
              "comparable",
              "not_comparable"
            ]
          },
          "review_status": {
            "type": "string",
            "enum": [
              "proposed",
              "reviewed"
            ]
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "format": "uri"
                }
              },
              "required": [
                "name",
                "url"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 20
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "type",
          "summary",
          "evidence",
          "basis",
          "comparability",
          "review_status",
          "reviews"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "reading_route": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "minItems": 0,
      "maxItems": 250
    },
    "narrative": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "turning_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 360
              },
              "result_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "minItems": 1,
                "maxItems": 4
              }
            },
            "required": [
              "title",
              "summary",
              "result_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5
        }
      },
      "required": [
        "overview",
        "turning_points"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "question",
    "scope",
    "lanes",
    "works",
    "results",
    "evidence",
    "relations",
    "reading_route"
  ],
  "additionalProperties": false
}
